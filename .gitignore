# Root allowlist: hdc drops zero-byte files with garbage (binary) names into the working directory; they cannot
# be matched by name, so everything at the root is ignored except the entries listed here.
/*
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/AI_WORKFLOW.md
!/README.md
!/submission
!/dev
!/docs
!/spec.md
!/src
!/suggested-host-venv
!/tests

# --- project rules ---
/.hvigor/
*.p12
*.p7b
*.jks
.env.local
*.zip
*.hap
*.app
*.cer
*.csr
*.pem

/src/entry/src/main/resources/rawfile/bot.json
/src/entry/src/main/resources/rawfile/harness.json

/.twilio_tokens
__pycache__/
*.pyc
